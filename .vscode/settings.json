{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "eslint.workingDirectories": [
    { "directory": "apps/web", "changeProcessCWD": true },
    { "directory": "apps/mobile", "changeProcessCWD": true }
  ],
  "files.associations": {
    "*.html": "html",
    "*.HTML": "html"
  },
  "liveServer.settings.port": 5500,
  "liveServer.settings.root": "/",
  "liveServer.settings.file": "",
  "liveServer.settings.host": "0.0.0.0",
  "liveServer.settings.useLocalIp": false,
  "liveServer.settings.NoBrowser": false,
  "liveServer.settings.fullReload": true,
  "liveServer.settings.wait": 100,
  "liveServer.settings.ignoreFiles": [".vscode/**", ".git/**", "apps/**", "packages/**"],
  "typescript.tsdk": "node_modules/typescript/lib"
}
