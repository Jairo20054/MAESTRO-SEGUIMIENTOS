<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sistema personal para desarrollar cultura, inteligencia, presencia, disciplina digital, masculinidad saludable y vitalidad.">
  <title>Proyecto Carácter | Sistema integral de crecimiento</title>
  <style>
    :root{
      --bg:#07100f;--surface:#0e1a18;--surface-2:#13231f;--surface-3:#192d28;
      --text:#f5f7f4;--muted:#9caea8;--muted-2:#cbd7d2;--line:rgba(255,255,255,.10);
      --gold:#e6bd68;--gold-2:#f5d99b;--green:#55cf91;--blue:#6aa9ff;--red:#ff7d7d;--orange:#f2a65a;
      --shadow:0 24px 70px rgba(0,0,0,.30);--radius:24px;--sidebar:278px;
      --font:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    }
    html[data-theme="light"]{
      --bg:#f2f5f1;--surface:#fff;--surface-2:#f5f8f5;--surface-3:#e9f0eb;
      --text:#15221d;--muted:#65756e;--muted-2:#374840;--line:rgba(18,45,33,.12);
      --shadow:0 22px 58px rgba(29,53,41,.11);--gold:#a87319;--gold-2:#85590f;--green:#188557;--blue:#2868c7;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;min-height:100vh;background:radial-gradient(circle at 5% 0%,rgba(85,207,145,.12),transparent 32rem),radial-gradient(circle at 98% 2%,rgba(230,189,104,.12),transparent 30rem),var(--bg);color:var(--text);font-family:var(--font);line-height:1.5}
    button,input,textarea,select{font:inherit}
    button{cursor:pointer}
    a{color:var(--gold-2)}
    .app{display:grid;grid-template-columns:var(--sidebar) minmax(0,1fr);min-height:100vh}
    .sidebar{position:sticky;top:0;height:100vh;padding:18px 14px;border-right:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(18px);overflow:auto;z-index:50}
    .brand{display:flex;gap:12px;align-items:center;padding:6px 8px 20px}
    .brand-mark{width:50px;height:50px;border-radius:17px;display:grid;place-items:center;background:linear-gradient(145deg,var(--gold),#8e6424);color:#172015;font-size:23px;font-weight:950;box-shadow:0 14px 34px rgba(230,189,104,.22)}
    .brand h1{font-size:15px;margin:0;letter-spacing:.01em}.brand p{margin:2px 0 0;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.11em}
    .nav-label{padding:11px 12px 6px;color:var(--muted);font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}
    .nav-btn{width:100%;border:0;background:transparent;color:var(--muted);border-radius:15px;padding:11px 12px;display:flex;align-items:center;gap:11px;text-align:left;margin:2px 0;font-weight:760}
    .nav-btn:hover{background:var(--surface-2);color:var(--text)}
    .nav-btn.active{background:linear-gradient(135deg,rgba(230,189,104,.20),rgba(85,207,145,.10));color:var(--text);box-shadow:inset 0 0 0 1px rgba(230,189,104,.20)}
    .nav-icon{width:24px;text-align:center;font-size:17px}
    .side-status{margin-top:18px;padding:15px;background:var(--surface-2);border:1px solid var(--line);border-radius:19px}
    .side-status small{color:var(--muted);font-size:11px}.side-status strong{display:block;font-size:25px;margin:3px 0}.side-status p{color:var(--muted);font-size:11px;margin:7px 0 0}
    .progress{height:9px;background:var(--surface-3);border-radius:99px;overflow:hidden}.progress>i{height:100%;display:block;width:0;background:linear-gradient(90deg,var(--gold),var(--green));border-radius:inherit;transition:.35s ease}
    .main{min-width:0}
    .topbar{height:76px;position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;padding:0 26px;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(18px)}
    .top-title h2{font-size:18px;margin:0}.top-title p{font-size:12px;color:var(--muted);margin:2px 0 0}
    .top-actions{display:flex;gap:8px;align-items:center}
    .mobile-menu{display:none}
    .btn{border:1px solid var(--line);background:var(--surface-2);color:var(--text);padding:10px 13px;border-radius:13px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;transition:.18s ease}
    .btn:hover{transform:translateY(-1px);border-color:rgba(230,189,104,.38)}
    .btn.primary{background:linear-gradient(135deg,var(--gold),#b68131);color:#172015;border-color:transparent}
    .btn.success{background:linear-gradient(135deg,var(--green),#278d61);color:#07100f;border-color:transparent}
    .btn.danger{color:var(--red)}.btn.icon{width:42px;height:42px;padding:0}
    .content{padding:26px;max-width:1550px;margin:0 auto}
    .view{display:none}.view.active{display:block;animation:fade .22s ease}
    @keyframes fade{from{opacity:.35;transform:translateY(5px)}to{opacity:1;transform:none}}
    .hero{position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(230,189,104,.16),rgba(85,207,145,.10)),var(--surface);border:1px solid var(--line);border-radius:32px;padding:31px;box-shadow:var(--shadow)}
    .hero:after{content:"V";position:absolute;right:24px;top:-80px;font-family:Georgia,serif;font-size:250px;font-weight:900;color:rgba(230,189,104,.055);transform:rotate(8deg)}
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.7fr);gap:26px;align-items:center}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--gold-2);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.14em}
    .hero h1{font-size:clamp(32px,5vw,62px);line-height:1.02;letter-spacing:-.055em;margin:12px 0}.hero h1 span{color:var(--gold-2)}
    .hero p{max-width:820px;color:var(--muted);margin:0;line-height:1.65}
    .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.chip{padding:7px 10px;border:1px solid var(--line);background:var(--surface-2);border-radius:999px;color:var(--muted-2);font-size:11px;font-weight:750}.chip.gold{color:var(--gold-2);border-color:rgba(230,189,104,.28)}
    .hero-score{background:rgba(7,16,15,.28);border:1px solid var(--line);border-radius:24px;padding:19px;display:grid;grid-template-columns:118px 1fr;align-items:center;gap:16px}
    html[data-theme="light"] .hero-score{background:rgba(255,255,255,.46)}
    .ring{--score:0;width:112px;height:112px;border-radius:50%;background:conic-gradient(var(--green) calc(var(--score)*1%),var(--surface-3) 0);display:grid;place-items:center;position:relative}
    .ring:before{content:"";position:absolute;width:83px;height:83px;border-radius:50%;background:var(--surface)}.ring strong{position:relative;font-size:25px}.hero-score h3{margin:0 0 5px}.hero-score p{font-size:12px;line-height:1.5}
    .metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin:17px 0}.metric,.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
    .metric{padding:17px}.metric small{color:var(--muted);font-weight:750}.metric strong{display:block;font-size:27px;margin:3px 0;letter-spacing:-.04em}.metric span{font-size:11px;color:var(--muted)}
    .grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:15px}.span-12{grid-column:span 12}.span-9{grid-column:span 9}.span-8{grid-column:span 8}.span-7{grid-column:span 7}.span-6{grid-column:span 6}.span-5{grid-column:span 5}.span-4{grid-column:span 4}.span-3{grid-column:span 3}
    .card{padding:20px}.card-head,.section-title{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}.card-head{margin-bottom:15px}.card h3,.card h4{margin:0}.card h3{font-size:18px}.card p{color:var(--muted)}
    .section-title{align-items:end;margin:0 0 17px}.section-title h2{font-size:28px;margin:0;letter-spacing:-.03em}.section-title p{margin:4px 0 0;color:var(--muted)}
    .habit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .habit{display:grid;grid-template-columns:auto 1fr auto;gap:11px;align-items:center;background:var(--surface-2);border:1px solid var(--line);border-radius:17px;padding:12px;transition:.16s ease}
    .habit.done{border-color:rgba(85,207,145,.38);background:linear-gradient(135deg,rgba(85,207,145,.12),var(--surface-2))}.habit-icon{width:39px;height:39px;border-radius:13px;background:var(--surface-3);display:grid;place-items:center}.habit b{display:block;font-size:13px}.habit small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.habit input{width:20px;height:20px;accent-color:var(--green)}
    .form-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:11px}.field{grid-column:span 12}.f6{grid-column:span 6}.f4{grid-column:span 4}.f3{grid-column:span 3}.f2{grid-column:span 2}
    label{display:block;color:var(--muted);font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;margin:0 0 6px}
    input,textarea,select{width:100%;background:var(--surface-2);color:var(--text);border:1px solid var(--line);border-radius:13px;padding:11px 12px;outline:none}
    input:focus,textarea:focus,select:focus{border-color:rgba(230,189,104,.60);box-shadow:0 0 0 3px rgba(230,189,104,.10)}textarea{min-height:102px;resize:vertical}
    .action-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:13px}
    .quote{padding:18px;border-left:3px solid var(--gold);background:var(--surface-2);border-radius:0 17px 17px 0;color:var(--muted-2);font-family:Georgia,serif;font-size:17px;line-height:1.6}.quote small{display:block;color:var(--muted);font-family:var(--font);font-size:11px;margin-top:7px}
    .mini-chart{height:150px;display:flex;align-items:end;gap:8px;padding-top:12px}.bar-item{flex:1;min-width:28px;text-align:center}.bar-item i{display:block;min-height:4px;background:linear-gradient(180deg,var(--green),var(--gold));border-radius:9px 9px 3px 3px;transition:.3s ease}.bar-item small{font-size:9px;color:var(--muted)}.bar-item b{display:block;font-size:10px;margin:4px 0 2px}
    .pillar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.pillar{position:relative;overflow:hidden;background:var(--surface-2);border:1px solid var(--line);border-radius:20px;padding:17px}.pillar:before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:linear-gradient(var(--gold),var(--green))}.pillar .num{font-size:11px;color:var(--gold-2);font-weight:900}.pillar h3{margin:7px 0 6px;font-size:15px}.pillar p{font-size:12px;margin:0;line-height:1.55}
    .method{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.method>div{padding:15px;border-radius:18px;background:var(--surface-2);border:1px solid var(--line)}.method strong{font-size:26px;color:var(--gold-2)}.method b{display:block;margin:3px 0}.method p{font-size:11px;margin:0}
    .week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.week-day{padding:12px 9px;border:1px solid var(--line);border-radius:16px;background:var(--surface-2);min-height:130px}.week-day b{font-size:12px;color:var(--gold-2)}.week-day p{font-size:11px;line-height:1.45;margin:7px 0;color:var(--muted-2)}
    .check-list{display:grid;gap:8px}.check{display:flex;gap:10px;align-items:flex-start;padding:11px;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;color:var(--muted-2);font-size:12px}.check input{width:18px;height:18px;flex:0 0 auto;accent-color:var(--green)}
    .table-wrap{overflow:auto;border:1px solid var(--line);border-radius:17px}table{width:100%;min-width:720px;border-collapse:collapse;background:var(--surface-2)}th,td{text-align:left;padding:11px 10px;border-bottom:1px solid var(--line);font-size:12px}th{color:var(--gold-2);background:rgba(230,189,104,.08)}td{color:var(--muted-2)}tr:last-child td{border-bottom:0}.table-btn{border:1px solid var(--line);background:var(--surface-3);color:var(--text);border-radius:9px;padding:6px 8px;font-size:10px;font-weight:800}
    .timer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px;background:var(--surface-2);border:1px solid var(--line);border-radius:19px}.timer-display{font-size:38px;font-weight:950;letter-spacing:.03em;color:var(--gold-2)}
    .callout{padding:15px;border:1px solid rgba(106,169,255,.25);background:rgba(106,169,255,.08);border-radius:17px;color:var(--muted-2);font-size:12px;line-height:1.55}.callout.gold{border-color:rgba(230,189,104,.26);background:rgba(230,189,104,.08)}.callout.red{border-color:rgba(255,125,125,.24);background:rgba(255,125,125,.07)}
    .protocol{counter-reset:step;display:grid;gap:9px}.protocol>div{position:relative;padding:13px 13px 13px 51px;background:var(--surface-2);border:1px solid var(--line);border-radius:16px;min-height:50px}.protocol>div:before{counter-increment:step;content:counter(step);position:absolute;left:12px;top:11px;width:28px;height:28px;border-radius:10px;display:grid;place-items:center;background:var(--surface-3);color:var(--gold-2);font-weight:900}.protocol b{font-size:12px}.protocol p{font-size:11px;margin:3px 0 0}
    .phase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.phase{padding:20px;border:1px solid var(--line);background:var(--surface-2);border-radius:22px}.phase .days{color:var(--gold-2);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.phase h3{margin:8px 0}.phase ul{padding-left:18px;color:var(--muted-2);font-size:12px;line-height:1.6}
    .schedule{display:grid;gap:8px}.schedule-row{display:grid;grid-template-columns:105px 1fr;gap:10px;align-items:center;padding:10px 12px;background:var(--surface-2);border:1px solid var(--line);border-radius:14px}.schedule-row b{color:var(--gold-2);font-size:12px}.schedule-row span{font-size:12px;color:var(--muted-2)}
    .resource-list{display:grid;gap:9px}.resource{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px;border-radius:15px;background:var(--surface-2);border:1px solid var(--line)}.resource b{font-size:12px}.resource p{font-size:11px;margin:3px 0 0}.resource a{font-size:11px;font-weight:800;white-space:nowrap}
    .toast{position:fixed;right:20px;bottom:20px;z-index:100;background:var(--text);color:var(--bg);padding:12px 15px;border-radius:14px;font-weight:800;font-size:12px;box-shadow:var(--shadow);opacity:0;transform:translateY(8px);pointer-events:none;transition:.22s ease}.toast.show{opacity:1;transform:none}
    .empty{padding:25px;text-align:center;border:1px dashed var(--line);border-radius:16px;color:var(--muted);font-size:12px}.hidden{display:none!important}.muted{color:var(--muted)}.tiny{font-size:11px;color:var(--muted)}.good{color:var(--green)}.warn{color:var(--orange)}.bad{color:var(--red)}
    @media(max-width:1180px){.metrics{grid-template-columns:repeat(3,1fr)}.week-grid{grid-template-columns:repeat(4,1fr)}.pillar-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:920px){.app{grid-template-columns:1fr}.sidebar{position:fixed;left:-310px;width:290px;transition:.25s ease;box-shadow:var(--shadow)}.sidebar.open{left:0}.mobile-menu{display:inline-flex}.content{padding:18px}.topbar{padding:0 17px}.hero-grid{grid-template-columns:1fr}.span-9,.span-8,.span-7,.span-6,.span-5,.span-4,.span-3{grid-column:span 12}.phase-grid{grid-template-columns:1fr}.week-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:620px){.top-actions .download-label{display:none}.top-title p{display:none}.hero{padding:22px}.hero-score{grid-template-columns:95px 1fr}.ring{width:90px;height:90px}.ring:before{width:66px;height:66px}.metrics{grid-template-columns:repeat(2,1fr)}.habit-grid,.pillar-grid,.method{grid-template-columns:1fr}.form-grid{display:block}.field{margin-bottom:10px}.week-grid{grid-template-columns:1fr}.section-title{align-items:flex-start;flex-direction:column}.schedule-row{grid-template-columns:83px 1fr}.metric strong{font-size:23px}}
    @media print{.sidebar,.topbar,.btn,.action-row,.no-print{display:none!important}.app{display:block}.content{padding:0}.view{display:block!important;page-break-after:always}.hero,.card,.metric{box-shadow:none}body{background:#fff;color:#111}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand"><div class="brand-mark">V</div><div><h1>PROYECTO CARÁCTER</h1><p>Vann Castillo · Sistema personal</p></div></div>
    <div class="nav-label">Centro de mando</div>
    <button class="nav-btn active" data-view="dashboard"><span class="nav-icon">◈</span>Panel de hoy</button>
    <button class="nav-btn" data-view="culture"><span class="nav-icon">📚</span>Cultura</button>
    <button class="nav-btn" data-view="intelligence"><span class="nav-icon">🧠</span>Inteligencia</button>
    <button class="nav-btn" data-view="presence"><span class="nav-icon">◆</span>Presencia atractiva</button>
    <button class="nav-btn" data-view="screen"><span class="nav-icon">◫</span>Control de pantalla</button>
    <button class="nav-btn" data-view="masculinity"><span class="nav-icon">♜</span>Masculinidad sana</button>
    <button class="nav-btn" data-view="vitality"><span class="nav-icon">⚡</span>Vitalidad</button>
    <button class="nav-btn" data-view="plan"><span class="nav-icon">◎</span>Plan de 90 días</button>
    <button class="nav-btn" data-view="backup"><span class="nav-icon">⬡</span>Seguridad y descarga</button>
    <div class="side-status"><small>Cumplimiento de hoy</small><strong id="sideScore">0%</strong><div class="progress"><i id="sideProgress"></i></div><p id="sideMessage">Empieza con una acción pequeña y verificable.</p></div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:10px"><button class="btn icon mobile-menu" id="menuBtn" aria-label="Abrir menú">☰</button><div class="top-title"><h2 id="viewTitle">Panel de hoy</h2><p id="todayLabel">Cargando fecha…</p></div></div>
      <div class="top-actions"><button class="btn icon" id="themeBtn" title="Cambiar tema">☀</button><button class="btn primary" id="quickDownload"><span>↓</span><span class="download-label">Descargar HTML</span></button></div>
    </header>

    <div class="content">
      <section class="view active" id="view-dashboard">
        <div class="hero">
          <div class="hero-grid">
            <div><div class="eyebrow">✦ Construcción diaria de identidad</div><h1>Conocimiento, presencia y <span>carácter.</span></h1><p>No buscas parecer superior. Buscas convertirte en un hombre con criterio, dominio propio, salud, fe, propósito y capacidad para cumplir su palabra. Cada casilla marcada necesita una acción real.</p><div class="chips"><span class="chip gold">Plan de 90 días</span><span class="chip">Autoguardado</span><span class="chip">Funciona sin internet</span><span class="chip">Progreso descargable</span></div></div>
            <div class="hero-score"><div class="ring" id="mainRing"><strong id="ringScore">0%</strong></div><div><h3 id="coachTitle">Da el primer paso</h3><p id="coachText">La disciplina comienza cuando haces lo importante antes de sentirte preparado.</p></div></div>
          </div>
        </div>
        <div class="metrics">
          <div class="metric"><small>Racha disciplinada</small><strong id="streakMetric">0 días</strong><span>Días con 80% o más</span></div>
          <div class="metric"><small>Lectura</small><strong id="pagesMetric">0 pág.</strong><span>Meta diaria: <i id="pagesGoalLabel">10</i></span></div>
          <div class="metric"><small>Estudio profundo</small><strong id="studyMetric">0 min</strong><span>Enfoque real, sin teléfono</span></div>
          <div class="metric"><small>Redes sociales</small><strong id="screenMetric">0 min</strong><span id="screenMetricHint">Meta: máximo 30 min</span></div>
          <div class="metric"><small>Vitalidad percibida</small><strong id="energyMetric">—/10</strong><span>Sueño, movimiento y ánimo</span></div>
        </div>
        <div class="grid">
          <article class="card span-8"><div class="card-head"><div><h3>Acciones esenciales de hoy</h3><p class="tiny">Marca solamente lo que realmente cumpliste.</p></div><input type="date" id="selectedDate" style="width:auto"></div><div class="habit-grid" id="habitGrid"></div></article>
          <article class="card span-4"><div class="card-head"><div><h3>Datos del día</h3><p class="tiny">La evidencia convierte intención en progreso.</p></div></div>
            <div class="form-grid">
              <div class="field f6"><label>Páginas leídas</label><input type="number" min="0" id="pagesInput"></div>
              <div class="field f6"><label>Estudio (min)</label><input type="number" min="0" id="studyInput"></div>
              <div class="field f6"><label>Redes (min)</label><input type="number" min="0" id="screenInput"></div>
              <div class="field f6"><label>Sueño (horas)</label><input type="number" min="0" max="15" step="0.25" id="sleepInput"></div>
              <div class="field f6"><label>Energía 1–10</label><input type="number" min="1" max="10" id="energyInput"></div>
              <div class="field f6"><label>Entrenamiento</label><select id="trainingInput"><option value="">Sin registrar</option><option>Fuerza</option><option>Cardio</option><option>Caminata</option><option>Movilidad</option><option>Descanso</option></select></div>
              <div class="field"><label>Victoria o evidencia del día</label><textarea id="victoryInput" placeholder="¿Qué hiciste aunque no tuvieras ganas?"></textarea></div>
            </div><div class="action-row"><button class="btn success" id="saveDayBtn">✓ Guardar día</button><button class="btn" id="clearDayBtn">Limpiar fecha</button></div>
          </article>
          <article class="card span-7"><div class="card-head"><div><h3>Últimos siete días</h3><p class="tiny">Porcentaje de acciones esenciales completadas.</p></div></div><div class="mini-chart" id="weeklyChart"></div></article>
