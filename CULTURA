    $("#saveCharacterBtn").onclick=()=>{state.notes.character={courage:$("#courageAction").value,responsibility:$("#responsibilityAction").value,boundary:$("#boundaryAction").value,service:$("#serviceAction").value,emotion:$("#emotionAction").value};persist("Diario de carácter guardado")};
    $("#addPromiseBtn").onclick=()=>$("#promiseForm").classList.toggle("hidden");$("#savePromiseBtn").onclick=()=>{const text=$("#promiseText").value.trim();if(!text)return alert("Escribe el compromiso.");state.promises.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),text,person:$("#promisePerson").value.trim(),date:$("#promiseDate").value,done:false});["promiseText","promisePerson","promiseDate"].forEach(id=>$("#"+id).value="");$("#promiseForm").classList.add("hidden");persist("Promesa registrada");renderPromises()};
    $("#saveTrainingBtn").onclick=()=>{$$('[data-training]').forEach(x=>state.notes.training[x.dataset.training]=x.value);$$('[data-training-note]').forEach(x=>state.notes.training["n"+x.dataset.trainingNote]=x.value);persist("Semana de entrenamiento guardada")};
    $("#saveWeeklyBtn").onclick=()=>{state.notes.weekly={wins:$("#weeklyWins").value,failures:$("#weeklyFailures").value,lesson:$("#weeklyLesson").value,focus:$("#weeklyFocus").value};persist("Revisión semanal guardada")};
    $("#quickDownload").onclick=exportHtml;$("#downloadHtmlBtn").onclick=exportHtml;$("#exportJsonBtn").onclick=exportJson;$("#importJsonBtn").onclick=()=>$("#importFile").click();$("#importFile").onchange=e=>{const file=e.target.files[0];if(!file)return;const r=new FileReader();r.onload=()=>{try{const p=JSON.parse(r.result);state=normalize(p.data||p);persist("Respaldo restaurado");location.reload()}catch{alert("El archivo no contiene un respaldo válido.")}};r.readAsText(file);e.target.value=""};
    $("#resetAllBtn").onclick=()=>{if(confirm("¿Reiniciar TODO el sistema? Descarga un respaldo antes. Esta acción borrará el progreso de este navegador.")){state=defaultState();localStorage.setItem(KEY,JSON.stringify(state));location.reload()}};
  }
  function init(){document.documentElement.dataset.theme=state.theme;$("#themeBtn").textContent=state.theme==="dark"?"☀":"☾";$("#todayLabel").textContent=fmt(iso());renderStatic();renderBooks();renderPromises();loadNotes();loadDayFields();updateTimer();bind();switchView(state.lastView||"dashboard");updateBackup()}
  document.addEventListener("DOMContentLoaded",init);
})();
</script>
</body>
</html>
